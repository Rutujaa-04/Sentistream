# SentiStream Environment Variables Template

# Deployment safety switches. Keep both false for public deployments.
APP_ENV=development
ENABLE_TEST_ENDPOINTS=false
ENABLE_DASHBOARD_CONTROLS=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTISTREAM_DOMAIN=localhost

# ==========================================
# 1. External APIs
# ==========================================
# Register for a free token at https://finnhub.io/
FINNHUB_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Portfolio defaults (Alpaca adapter, when selected, targets paper trading)
INITIAL_PORTFOLIO_CAPITAL=100000.0
TRADING_ENGINE=simulated

# ==========================================
# 2. Redis Stream Configuration
# ==========================================
# Local Docker Redis (default)
REDIS_URL=redis://localhost:6379

# ==========================================
# 3. ClickHouse DB Configuration
# ==========================================
# Local Docker ClickHouse (default)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=sentistream
CLICKHOUSE_DATABASE=default

# ==========================================
# 4. Statistical Drift Detection
# ==========================================
# The rolling window size for computing baseline distributions
DRIFT_WINDOW_SIZE=100
# Z-score outlier trigger boundary (2.0 = 95% of normal distribution)
DRIFT_ALERT_Z_THRESHOLD=2.0
# Minimum samples required in the window before alerts can fire
DRIFT_MIN_SAMPLES=30

# ==========================================
# 5. General Operations
# ==========================================
# Ingestor polling interval in seconds
POLL_INTERVAL=60
STREAM_MAX_RETRIES=3
STREAM_RECLAIM_IDLE_MS=60000
STREAM_RECLAIM_INTERVAL_SECONDS=5
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=60
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Trading execution strategy: threshold
TRADING_STRATEGY=threshold
